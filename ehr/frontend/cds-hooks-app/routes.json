{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "pages": [
    {
      "component": "adminPage",
      "route": "cds-hooks"
    }
  ],
  "extensions": [
    {
      "name": "cds-hooks-admin-card-link",
      "slot": "system-admin-page-card-link-slot",
      "component": "adminCardLink",
      "privileges": ["Manage Global Properties"]
    },
    {
      "name": "cds-hooks-patient-view-cards",
      "slot": "top-of-all-patient-dashboards-slot",
      "component": "patientViewCards",
      "order": 0
    }
  ]
}
